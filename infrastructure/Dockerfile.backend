# FastAPI backend (SQLite for local use, PostgreSQL in Azure).
# Build from backend/:  docker build -f ../infrastructure/Dockerfile.backend .
FROM python:3.11-slim AS builder

WORKDIR /app
COPY pyproject.toml requirements.lock ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.lock

FROM python:3.11-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser

WORKDIR /app
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY app app/
COPY alembic alembic/
COPY alembic.ini .
RUN mkdir -p /app/data && chown -R appuser /app/data

# PYTHONPATH lets alembic and `python -m app.cli` import the app, not only uvicorn.
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8000
USER appuser
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s CMD curl -fsS http://127.0.0.1:8000/health || exit 1

# Schema changes are applied separately with `alembic upgrade head` (see docs/deployment.md).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
