# In2IT ERP - Environment Configuration
# Copy to .env (repo root or backend/) and fill in values. Never commit .env.
# In Azure these come from App Service settings / Key Vault references (see docs/deployment.md).

# ─── Application ───
APP_NAME=In2IT-ERP
APP_ENV=development            # development | production (production refuses weak secrets)
DEBUG=false
SQL_ECHO=false
# ENABLE_API_DOCS=             # default: on outside production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
API_V1_PREFIX=/api/v1

# ─── Database ───
# Apply the schema with `alembic upgrade head` (from backend/) before starting the API.
DATABASE_URL=sqlite+aiosqlite:///./in2it_erp.db
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/in2it_erp?ssl=require

# ─── Local sign-in tokens ───
# Leave empty in development for an ephemeral random key (sessions reset on restart).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# REFRESH_COOKIE_SECURE=       # default: secure outside development

# ─── CORS (explicit origins only) ───
CORS_ORIGINS=["http://localhost:5173"]
TRUST_PROXY_HEADERS=false      # true only behind a trusted reverse proxy

# ─── Account security ───
ALLOW_SELF_REGISTRATION=false
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# LOCAL_AUTH_MODE=             # all | break_glass_only | disabled (default: all until Entra is configured)
BREAK_GLASS_EMAILS=[]

# ─── Bootstrap (empty database only) ───
# SEED_ON_STARTUP=             # default: on outside production
SEED_ADMIN_EMAIL=admin@in2it.com
# SEED_ADMIN_PASSWORD=         # optional: creates admin@ on an empty DB; prefer `python -m app.cli bootstrap-admin`
SEED_DEMO_DATA=false

# ─── Microsoft Entra ID (docs/entra-setup.md) ───
# ENTRA_TENANT_ID=<tenant GUID>
# ENTRA_SPA_CLIENT_ID=<SPA app registration client ID>
# ENTRA_API_CLIENT_ID=<API app registration client ID>
# ENTRA_API_AUDIENCE=          # default: api://<ENTRA_API_CLIENT_ID>
# ENTRA_API_SCOPE=access_as_user
# ENTRA_ADMIN_APP_ROLE=ERP.Admin
# ENTRA_ALLOWED_TENANT_IDS=[]  # default: [ENTRA_TENANT_ID]
# ENTRA_LINK_BY_EMAIL=true
# ENTRA_AUTO_PROVISION=false

# ─── Provisioning connectors ───
# GRAPH_CLIENT_ID=<app registration with AppRoleAssignment.ReadWrite.All>
# GRAPH_CLIENT_SECRET_REF=GRAPH_CLIENT_SECRET   # name of the variable holding the secret
# GRAPH_CLIENT_SECRET=
# Per-application credentials are referenced by name from the Admin Console, e.g.
# CRM_PROVISIONING_TOKEN=
PROVISIONING_WORKER_ENABLED=true
PROVISIONING_POLL_SECONDS=10
PROVISIONING_MAX_ATTEMPTS=5
CONNECTOR_TIMEOUT_SECONDS=15
