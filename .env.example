# In2IT ERP - Environment Configuration
# Copy this file to .env and fill in your values

# ─── Application ───
APP_NAME=In2IT-ERP
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-string-in-production
API_V1_PREFIX=/api/v1

# ─── Database ───
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./in2it_erp.db

# PostgreSQL (uncomment for production/Azure)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/in2it_erp

# ─── JWT Auth ───
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ───
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Microsoft Entra ID (Future) ───
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_AUTHORITY=https://login.microsoftonline.com/{tenant_id}

# ─── Azure (Future Deployment) ───
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_KEY_VAULT_URL=
