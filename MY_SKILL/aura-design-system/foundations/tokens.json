{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "AURA Premium UI",
  "version": "1.0.0",
  "font": {
    "display": { "value": "Fraunces, New York, Playfair Display, Georgia, serif", "type": "fontFamily" },
    "sans": { "value": "Inter, -apple-system, SF Pro Text, Roboto, system-ui, sans-serif", "type": "fontFamily" },
    "mono": { "value": "JetBrains Mono, SF Mono, ui-monospace, monospace", "type": "fontFamily" }
  },
  "type": {
    "displayXl": { "size": 40, "lineHeight": 44, "weight": 700, "family": "display", "tracking": -0.02 },
    "displayLg": { "size": 32, "lineHeight": 36, "weight": 700, "family": "display", "tracking": -0.02 },
    "displayMd": { "size": 26, "lineHeight": 30, "weight": 600, "family": "display", "tracking": -0.02 },
    "titleLg": { "size": 22, "lineHeight": 28, "weight": 600, "family": "sans" },
    "titleMd": { "size": 18, "lineHeight": 24, "weight": 600, "family": "sans" },
    "bodyLg": { "size": 17, "lineHeight": 24, "weight": 500, "family": "sans" },
    "bodyMd": { "size": 15, "lineHeight": 22, "weight": 400, "family": "sans" },
    "labelMd": { "size": 14, "lineHeight": 18, "weight": 500, "family": "sans" },
    "labelSm": { "size": 13, "lineHeight": 16, "weight": 500, "family": "sans" },
    "overline": { "size": 12, "lineHeight": 16, "weight": 600, "family": "sans", "tracking": 0.06, "uppercase": true }
  },
  "color": {
    "brand": { "900": "#6E0A12", "700": "#8F0E19", "600": "#B3121F", "400": "#D93A47", "100": "#FDE8EA" },
    "cta": { "600": "#E85D12", "500": "#F26A1B", "400": "#F7931E" },
    "tile": { "700": "#0A3FCC", "500": "#1E6BFF", "300": "#6FA3FF", "100": "#E3EDFF" },
    "semantic": {
      "success": "#0E8A4E", "warning": "#D97706", "danger": "#DC2626", "info": "#1E6BFF",
      "mint": "#D8F5E6", "mintInk": "#0E8A4E", "lilac": "#EBDDFB", "lilacInk": "#6A1FB8", "sky": "#E6F3FF", "gold": "#F2B134"
    },
    "light": {
      "canvas": "#F5F6FA", "surface": "#FFFFFF", "surface2": "#F0F2F7",
      "ink900": "#0B1220", "ink700": "#2A3242", "ink500": "#6B7385", "ink300": "#B9BFCC",
      "line": "rgba(11,18,32,0.08)",
      "glass": "rgba(255,255,255,0.62)", "glassStrong": "rgba(255,255,255,0.82)", "glassBorder": "rgba(255,255,255,0.75)"
    },
    "dark": {
      "canvas": "#0B0C10", "surface": "#15171E", "surface2": "#1C1F28",
      "ink900": "#F4F6FB", "ink700": "#C9CFDB", "ink500": "#8A91A3", "ink300": "#4A5062",
      "line": "rgba(255,255,255,0.08)",
      "glass": "rgba(21,23,30,0.58)", "glassStrong": "rgba(21,23,30,0.82)", "glassBorder": "rgba(255,255,255,0.10)",
      "success": "#34C77B", "mint": "rgba(14,138,78,0.22)", "mintInk": "#5FE0A3", "lilac": "rgba(106,31,184,0.28)", "lilacInk": "#D3B4FF", "sky": "rgba(30,107,255,0.14)"
    }
  },
  "gradient": {
    "header": { "angle": 180, "stops": [["#B3121F", 0], ["#8F0E19", 0.55], ["#6E0A12", 1]] },
    "headerVignette": "radial-gradient(120% 80% at 50% -20%, rgba(255,255,255,0.18), transparent 60%)",
    "cta": { "angle": 180, "stops": [["#F7931E", 0], ["#F26A1B", 1]] },
    "tile": { "type": "radial", "center": [0.3, 0.15], "stops": [["#6FA3FF", 0], ["#1E6BFF", 0.45], ["#0A3FCC", 1]] },
    "tileGloss": { "type": "radial", "center": [0.3, 0.18], "stops": [["rgba(255,255,255,0.55)", 0], ["rgba(255,255,255,0)", 1]] },
    "sky": { "angle": 180, "stops": [["#CFE6FF", 0], ["#EAF4FF", 0.6], ["#F5F6FA", 1]] },
    "aurora": { "angle": 135, "stops": [["#FF8A3D", 0], ["#FFB347", 0.3], ["#2F80ED", 0.7], ["#0A3FCC", 1]] },
    "gold": { "angle": 135, "stops": [["#F9D976", 0], ["#F39F2C", 1]] },
    "festive": { "angle": 180, "stops": [["#B3121F", 0], ["#5C0810", 1]] }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "gutter": 20, "touch": 56 },
  "radius": { "sm": 10, "md": 14, "lg": 16, "xl": 20, "2xl": 22, "3xl": 28, "pill": 999 },
  "shadow": {
    "sm": { "x": 0, "y": 2, "blur": 8, "spread": -2, "color": "rgba(11,18,32,0.08)" },
    "md": { "x": 0, "y": 10, "blur": 30, "spread": -12, "color": "rgba(11,18,32,0.14)" },
    "lg": { "x": 0, "y": 24, "blur": 60, "spread": -20, "color": "rgba(11,18,32,0.22)" },
    "tile": { "x": 0, "y": 12, "blur": 32, "spread": -8, "color": "rgba(30,107,255,0.45)" },
    "cta": { "x": 0, "y": 14, "blur": 32, "spread": -10, "color": "rgba(242,106,27,0.55)" },
    "haloTile": { "x": 0, "y": 0, "blur": 0, "spread": 8, "color": "rgba(227,237,255,0.6)" }
  },
  "glass": { "blur": 24, "saturate": 1.6, "highlight": "rgba(255,255,255,0.55)" },
  "motion": {
    "duration": { "instant": 80, "fast": 160, "base": 260, "slow": 420, "cinematic": 700 },
    "easing": {
      "outExpo": [0.16, 1, 0.3, 1],
      "inOut": [0.65, 0, 0.35, 1]
    },
    "spring": {
      "snappy": { "stiffness": 400, "damping": 30, "mass": 1 },
      "soft": { "stiffness": 220, "damping": 26, "mass": 1 },
      "bouncy": { "stiffness": 300, "damping": 18, "mass": 0.9 },
      "sheet": { "stiffness": 320, "damping": 32, "mass": 1 }
    },
    "stagger": 40,
    "pressScale": 0.97,
    "hoverLift": -2,
    "entrance": { "translateY": 16, "opacityFrom": 0, "duration": 420, "easing": "outExpo" }
  }
}
